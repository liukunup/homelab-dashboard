# Project name
COMPOSE_PROJECT_NAME=dashboard-stack

# Network name
NETWORK_NAME=dashboard-stack-network

# Registry
REGISTRY=docker.io

# MySQL
MYSQL_IMAGE=mysql:8.4.6
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
MYSQL_DATABASE=dashboard
MYSQL_USER=dashboard
MYSQL_PASSWORD=your_secure_password_here

# phpMyAdmin
PMA_IMAGE=phpmyadmin/phpmyadmin:5.2.2
PMA_PORT=8082
PMA_ARBITRARY=0

# Grafana
GRAFANA_IMAGE=grafana/grafana:9.5.7
GRAFANA_PORT=3000
GRAFANA_ADMIN_USERNAME=admin
GRAFANA_ADMIN_PASSWORD=your_secure_admin_password_here